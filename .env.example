# ── Set these in Vercel > Project > Settings > Environment Variables ──

# Token the browser app sends as "Authorization: Bearer <token>".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LAKH_APP_TOKEN=

# Apps Script web app (from code.gs deployment)
LAKH_GAS_URL=https://script.google.com/macros/s/XXXX/exec
LAKH_GAS_KEY=            # = AUTH_TOKEN Script Property in Apps Script
# LAKH_GAS_TIMEOUT_MS=25000

# Local VPS AI (Hermes / Qwen) behind Cloudflare Tunnel or VPN.
# Any OpenAI-compatible /v1/chat/completions endpoint (llama.cpp, vLLM, Ollama, ...)
AI_URL=https://ai.example.com/v1/chat/completions
AI_MODEL=qwen
# AI_API_KEY=
# AI_TIMEOUT_MS=9000     # PRD: AI response max 10 s
# Cloudflare Access service token, if the tunnel is protected by Access:
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# Only needed if the frontend is served from a different origin than this API
# ALLOWED_ORIGIN=https://lakh.vercel.app
